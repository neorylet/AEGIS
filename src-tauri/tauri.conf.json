{
  "build": {
    "distDir": "../frontend/dist",
    "devPath": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.aegis.security",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "Developer Tool"
    },
    "allowlist": {
      "shell": {
        "open": true
      }
    },
    "windows": [
      {
        "title": "AEGIS Security System",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5173 ws://localhost:5173; img-src 'self' https://picsum.photos"
    }
  }
}