{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AEGIS",
  "version": "0.1.0",
  "identifier": "com.aegis.security",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AEGIS Security System",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3000 ws://localhost:3000; img-src 'self' https://picsum.photos"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.aegis.security",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Developer Tool"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}